{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app4",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7d391579-9164-4434-96a1-9336cba43ed3","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3facaf5b051049069b23a072b9db2a58" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
